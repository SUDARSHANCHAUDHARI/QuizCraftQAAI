# Get your free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-1.5-flash is free tier)
GEMINI_MODEL=gemini-1.5-flash

# Shared secret: callers must send it in the X-API-Token header. Requests are refused when unset.
API_TOKEN=

# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=https://sudarshanchaudhari.github.io,http://localhost:5173
